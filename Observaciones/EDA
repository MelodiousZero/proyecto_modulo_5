import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Leer el CSV
df = pd.read_csv('E:/Users/Randy GM/Downloads/comparacion.csv')

# Ordenar los modelos por R2_score para que la gráfica quede más clara (opcional)
df = df.sort_values('Adjusted_R2', ascending=True)

# Configurar posiciones de las barras
x = np.arange(len(df))          # posiciones base
width = 0.35                    # ancho de cada barra

# Crear la figura
fig, ax = plt.subplots(figsize=(12, 6))

# Barras de R2_score (color azul)
bars1 = ax.bar(x - width/2, df['Adjusted_R2'], width, label='R²',
               color='#2E86AB', edgecolor='white', linewidth=0.5)

# Barras de Adjusted_R2 (color naranja/rojo)
bars2 = ax.bar(x + width/2, df['Adjusted_R2(GridSearchCV)'], width, label='R² (GridSearch)',
               color='#A23B72', edgecolor='white', linewidth=0.5)

# Añadir etiquetas, título y leyenda
ax.set_xlabel('Modelo', fontsize=12)
ax.set_ylabel('Valor', fontsize=12)
ax.set_title('Comparación de R² ajustado y R² Ajustado con gridsearch', fontsize=14, fontweight='bold')
ax.set_xticks(x)
ax.set_xticklabels(df['Model'], rotation=45, ha='right', fontsize=10)
ax.legend(fontsize=11)

# Mostrar el valor encima de cada barra (opcional)
for bar in bars1 + bars2:
    height = bar.get_height()
    ax.annotate(f'{height:.3f}',
                xy=(bar.get_x() + bar.get_width()/2, height),
                xytext=(0, 3),  # desplazamiento vertical
                textcoords="offset points",
                ha='center', va='bottom', fontsize=7)

# Rejilla ligera para facilitar lectura
ax.yaxis.grid(True, linestyle='--', alpha=0.3)
ax.set_axisbelow(True)

plt.tight_layout()
plt.show()
